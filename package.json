{
  "name": "resonance",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-first 2.5D action Metroidvania with solo and 1-4 player online co-op.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @resonance/web-client dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:determinism": "pnpm --filter @resonance/simulation test",
    "lint": "pnpm -r --if-present lint",
    "check:bundle": "node tools/check-web-bundle.mjs",
    "test:replay": "pnpm --filter @resonance/replay-cli replay packages/test-fixtures/replays/m0-canonical.json",
    "test:replay:matrix": "pnpm --filter @resonance/replay-cli replay --matrix packages/test-fixtures/replays/m0-canonical.json",
    "test:browser:replay": "playwright test",
    "replay:fingerprint": "pnpm --filter @resonance/replay-cli replay --fingerprint",
    "blind-test:report": "pnpm --filter @resonance/blind-test-report report"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.0.18",
    "@playwright/test": "1.63.0"
  }
}
